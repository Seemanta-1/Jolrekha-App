rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myRole() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isStaff() { return signedIn() && myRole() in ['volunteer', 'authority', 'admin']; }
    function isAdmin() { return signedIn() && myRole() == 'admin'; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Private profile (phone, email). Everyone signs up as 'citizen'; only the admin raises the role
    // of an approved volunteer / ward council.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'citizen';
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid &&
        changes().hasOnly(['name', 'dismissedEvents', 'emailVerified']));
    }

    // Public name and points for the leaderboard.
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /incidents/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reporters == [request.auth.uid]
        && request.resource.data.status == 'reported';
      // Citizens can only add a report, a photo or a vote; staff can also change status and resolution fields.
      allow update: if isStaff() || (signedIn() && changes().hasOnly(
        ['reporters', 'depth', 'status', 'lastReportAt', 'updatedAt', 'history', 'voters', 'stillThere', 'gone',
         'hasPhoto', 'ai', 'aiBoost']));
    }

    // Report photos (small JPEG thumbnails), loaded only when someone opens the incident.
    match /photos/{incidentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is string && request.resource.data.data.size() < 700000;
    }

    // Clean-up drives: staff create them; anyone can join (add only themselves); the organiser closes them.
    match /events/{id} {
      allow read: if signedIn();
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin() ||
        (changes().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members));

      // Team chat: members only.
      match /messages/{msg} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/events/$(id)).data.members;
        }
        allow read: if signedIn() && isMember();
        allow create: if signedIn() && isMember()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000;
      }
    }

    match /stats/{doc} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /contacts/{area} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
